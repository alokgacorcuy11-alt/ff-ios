<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TrollStore / ldid installs only. These are private, jailbreak-class
	     entitlements: a development or free provisioning profile cannot grant
	     them, so codesign/zsign rejects the combination. Keep them out of
	     entitlements.plist so a normal sideload never sees them. -->

	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>platform-application</key>
	<true/>

	<!-- get-task-allow is still absent on purpose - see entitlements.plist -->
</dict>
</plist>
