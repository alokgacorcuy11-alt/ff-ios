# --- generated / derived -------------------------------------------------
# out/ is the offline metadata dump (classes.json is 5.9 MB, the string table
# 16.6 MB). All of it is regenerated by tools/metadata_structure.py and none of
# it is needed to build the dylib or package the IPA.
out/
logs/
state/
dist/
native/.theos/
.theos/
build.log
__pycache__/
*.pyc

# --- never commit a payload or a signing identity ------------------------
# android/app/feed is forged from android/payload by payload_forge.py, one
# container per build. Committing it would freeze one key and one name forever.
android/app/feed/
*.ipa
*.p12
*.pfx
*.mobileprovision
*.cer
*.certSigningRequest
*.key
cert.pem
key.pem

# --- editor / OS ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# --- wrangler local state (account id, deploy cache) ---------------------
.wrangler/
.dev.vars
