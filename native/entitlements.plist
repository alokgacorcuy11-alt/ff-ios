<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS will not load a dylib from an app that is not allowed to
	     debug itself. get-task-allow is what makes the injected dylib
	     actually get mapped by dyld on a re-signed build. -->
	<key>get-task-allow</key>
	<true/>

	<!-- keep the app's own identity, otherwise keychain + some SDKs break -->
	<key>application-identifier</key>
	<string>TEAMID.com.dts.freefireth</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TEAMID</string>
	<key>keychain-access-groups</key>
	<array>
		<string>TEAMID.com.dts.freefireth</string>
	</array>

	<!-- outbound HTTP to the proxy panel -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- only needed if you also install as a TrollStore app:
	     lets a loader write into the target's container -->
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>platform-application</key>
	<true/>
</dict>
</plist>
